# Nothing here is required to get the main site running — it works with
# zero env vars. These only matter if you fork this to a differently-named
# repo or branch (the admin panel's GitHub token is pasted in the browser
# at use-time, not stored as a server secret — see README.md).
GH_REPO_OWNER=mael12854
GH_REPO_NAME=ecoledespetitespauses
GH_BRANCH=main

# Used by /espace and the admin's "Cartes de cantine" tab only — the rest
# of the site works without them. On Vercel these are already set via
# vercel.json (build.env / env), so no dashboard config needed there.
# Only fill these in locally (in a gitignored .env.local) if you want to
# override them for local dev. These are the "publishable"/anon key of
# the Supabase project, safe to expose client-side (protected by that
# project's Row Level Security, not by secrecy). See README.md.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
